# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — see .gitignore.

# --- Client (exposed to the browser via Vite, must start with VITE_) ---
VITE_SUPABASE_URL=https://hwglha
VITE_SUPABASE_ANON_KEY=eyJhbGciOhtYWFS3YAvUgbj
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
VITE_MEMBERS_PORTAL_URL=
# AES-256 key (base64), 32 random bytes. MUST be byte-identical to the
# same variable in the members portal repo — see client/lib/badgeCrypto.ts.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VITE_BADGE_ENCRYPTION_KEY=REPLACE_ME_WITH_A_REAL_BASE64_32_BYTE_KEY

# --- Server only (never exposed to the browser) ---
SUPABASE_URL=https://hwglhastcmqgrvvxmaae.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIU.d7Hp-2bpZqvB673ZGE09EiDn5uBc
JWT_SECRET=JWT0SECREwb26739FABws38u3i
PING_MESSAGE="ping pong"

# --- Device trust (offline v2.0) ---
# Separate signing secret for long-lived device tokens (10-day offline
# authorization). Keep this distinct from JWT_SECRET so device tokens
# can be rotated/invalidated independently of session tokens.
DEVICE_TOKEN_SECRET=SHM-....xxxxx

